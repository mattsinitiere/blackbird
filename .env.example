# ---- Supabase (database + login) ----
# Supabase project -> Settings -> API. Safe to expose (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- AI Insights ----
# Pick ONE provider. Free: gemini, groq. Paid: openai, anthropic.
AI_PROVIDER=gemini

# Optional model override. Defaults if blank:
#   gemini   -> gemini-2.5-flash      (free)
#   groq     -> llama-3.3-70b-versatile (free)
#   openai   -> gpt-4o-mini           (paid)
#   anthropic-> claude-3-5-haiku-latest (paid)
AI_MODEL=

# Set the key for the ONE provider you chose. These are server-only secrets
# (no NEXT_PUBLIC_ prefix) so they are never exposed to the browser.
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Invite-only sign-up ----
# Public self-service sign-up stays OFF in Supabase. /signup asks for this
# shared code and, when it matches, the server sends a Supabase invite email
# (needs SUPABASE_SERVICE_ROLE_KEY). Rotate it here to close the door.
SIGNUP_INVITE_CODE=
# Server-only: Supabase -> Settings -> API -> service_role. Also powers the
# admin panel. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: where emailed links should return to. Defaults to the host that
# served the request (fine on Vercel production; set it if previews confuse it).
SITE_URL=
