# ---- Supabase (database + login) ----
# Supabase project -> Settings -> API. Safe to expose (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Blackbird AI ----
# Production runs OpenAI gpt-6-luna through Chat Completions with tools.
AI_PROVIDER=openai
# Blank means gpt-6-luna for openai (never a different model). Other
# providers' defaults: gemini-2.5-flash, llama-3.3-70b-versatile,
# claude-haiku-4-5. Set only if you deliberately want another model.
AI_MODEL=
# Fixed reasoning effort sent on every OpenAI request (never set by the
# browser; the Answer Style picker does not change it). One of
# none | minimal | low | medium | high. Blank means "none".
AI_REASONING_EFFORT=none
# Server-only key for the provider above (no NEXT_PUBLIC_ prefix).
OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: USD per 1M tokens, only used to estimate AI cost in
# Admin -> Analytics. Leave blank and cost shows as "Not set".
AI_PRICE_INPUT_PER_1M=
AI_PRICE_OUTPUT_PER_1M=

# ---- Invite-only sign-up ----
# Public self-service sign-up stays OFF in Supabase. /signup asks for this
# shared code and, when it matches, the server sends a Supabase invite email
# (needs SUPABASE_SERVICE_ROLE_KEY). Rotate it here to close the door.
SIGNUP_INVITE_CODE=
# Server-only: Supabase -> Settings -> API -> service_role. Also powers the
# admin panel and saving training plans (create_training_plan). Never expose
# in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: where emailed links should return to. Defaults to the host that
# served the request (fine on Vercel production; set it if previews confuse it).
SITE_URL=
